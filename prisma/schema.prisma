generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  logFiles     LogFile[]
  threats      Threat[]
  reports      Report[]

  @@index([email])
}

model LogFile {
  id         String   @id @default(uuid())
  userId     String
  filename   String
  fileType   String
  rawContent String
  uploadedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threats    Threat[]
  reports    Report[]

  @@index([userId])
  @@index([uploadedAt])
}

model Threat {
  id            String   @id @default(uuid())
  userId        String
  logFileId     String
  threatType    String
  severity      String
  sourceIp      String?
  description   String
  aiExplanation String
  evidence      String
  score         Int
  confidence    Float
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logFile       LogFile  @relation(fields: [logFileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([logFileId])
  @@index([severity])
  @@index([threatType])
  @@index([createdAt])
}

model Report {
  id              String   @id @default(uuid())
  userId          String
  logFileId       String
  title           String
  summary         String
  recommendations String[]
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logFile         LogFile  @relation(fields: [logFileId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([logFileId])
  @@index([createdAt])
}
