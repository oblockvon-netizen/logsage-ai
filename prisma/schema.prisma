generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  logFiles     LogFile[]
  threats      Threat[]
  reports      Report[]
}

model LogFile {
  id        String   @id @default(uuid())
  userId    String
  fileName  String
  mimeType  String
  sizeBytes Int
  status    String   @default("uploaded")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threats   Threat[]
  reports   Report[]
}

model Threat {
  id          String   @id @default(uuid())
  userId      String
  logFileId   String
  title       String
  severity    String
  category    String
  sourceIp    String?
  evidence    String
  explanation Json?
  confidence  Float?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logFile     LogFile  @relation(fields: [logFileId], references: [id], onDelete: Cascade)
}

model Report {
  id        String   @id @default(uuid())
  userId    String
  logFileId String
  title     String
  content   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logFile   LogFile  @relation(fields: [logFileId], references: [id], onDelete: Cascade)
}
